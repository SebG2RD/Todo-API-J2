# Copier ce fichier vers .env et remplir les valeurs.
# .env n'est jamais commité, .env.example l'est.

# Base de données. DB_HOST vaut le nom du service Postgres dans docker-compose.yml.
DB_HOST=db
DB_PORT=5432
DB_NAME=todo_db
DB_USER=todo_user
DB_PASSWORD=changer_ce_mot_de_passe

# Ports publiés sur la machine hôte.
# L'API écoute toujours sur 3000 dans le conteneur : seule la partie gauche du
# mapping change ici.
API_PORT=3000
ADMINER_PORT=8080
STATS_PORT=8000

# Registry : compte et version des images publiées
REGISTRY_USER=votre_pseudo_docker_hub
IMAGE_TAG=1.0.0
