node_modules
.env

# Supports de cours : lus, pas versionnés
*.pdf

# Clés SSH de déploiement. Cette ligne est écrite AVANT que la paire existe :
# une clé privée poussée par erreur ne se rattrape pas avec un commit de
# suppression, git log garde tout. Seule la publique part dans l'image, et elle
# y arrive par un COPY, pas par le dépôt.
deploy_key
deploy_key.pub
*.pem
id_ed25519*

# Le Secret du cluster, valeurs comprises. Seul k8s/todo-secret.example.yaml
# est versionné : un base64 dans un manifeste ne chiffre rien, il se relit en
# une commande. Cette ligne est écrite avant que le vrai fichier existe.
k8s/todo-secret.yaml

# Le kubeconfig donne les pleins pouvoirs sur le cluster à quiconque le lit.
kubeconfig*
*.kubeconfig

# Le tirage du script de chaos : la reponse, pas un livrable.
.incident
