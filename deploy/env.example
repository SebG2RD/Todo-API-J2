# Modèle du fichier /srv/todo/.env de la machine cible.
#
# Le vrai fichier est copié UNE FOIS à la main sur la machine, et n'entre
# jamais dans le dépôt : il porte le mot de passe de la base de production.
# La pipeline ne le touche pas, elle ne fait que passer IMAGE et TAG par
# l'environnement au moment du `docker compose up`.
#
# Le poser sur la machine cible, depuis le poste de travail :
#   scp -i deploy_key -P 2222 deploy/env.example root@localhost:/srv/todo/.env
#   ssh -i deploy_key -p 2222 root@localhost "vi /srv/todo/.env"

DB_NAME=todo_prod
DB_USER=todo_prod_user
DB_PASSWORD=a_remplacer_par_un_vrai_mot_de_passe

# IMAGE et TAG ne sont volontairement PAS écrits ici : la pipeline les fournit
# à chaque déploiement, et c'est ce qui rend la version déployée traçable.
# Les figer dans ce fichier ferait mentir le déploiement au premier oubli.
